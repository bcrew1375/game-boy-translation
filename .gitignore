# User-supplied ROMs and generated output
/rom/
/roms/*/*
!/roms/README.md
!/roms/*/README.md
/build/

# Local reverse-engineering evidence. None of this is distributable source.
/disassembly/
/analysis/
/translation/
/projects/*/analysis/
/projects/*/disassembly/
/projects/*/local/
/projects/*/original/
/projects/*/translation/strings.tsv
/projects/*/translation/glossary.tsv
/projects/*/translation/text_layout.tsv
/tools/bin/gb-text-build
/tools/bin/gb-text-catalog
/tests/test_text.py

# Extracted/generated media and build products anywhere else
*.gb
*.gbc
*.rom
*.gbs
*.vgm
*.wav
*.bin
*.png
*.o
*.map
*.sym
*.sav
*.s1

# Language/tool caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
