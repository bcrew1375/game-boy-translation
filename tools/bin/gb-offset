#!/usr/bin/env python3
import argparse, sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from gb.rom import parse_address
p=argparse.ArgumentParser(description='Convert bank:CPU-address to ROM file offset.')
p.add_argument('address', help='e.g. 17:4A20 or 0x1234')
a=p.parse_args(); print(f'0x{parse_address(a.address):X}')
