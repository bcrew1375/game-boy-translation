#!/usr/bin/env python3
"""Reject prohibited ROM-derived or generated material from repository source."""

from __future__ import annotations

import csv
import io
import re
import subprocess
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parents[2]
BANNED_PREFIXES = (
    "analysis/",
    "build/",
    "disassembly/",
    "rom/",
)
BANNED_PROJECT_COMPONENTS = {"disassembly", "local", "original"}
BANNED_BASENAMES = {"strings.tsv", "glossary.tsv", "text_layout.tsv"}
REVIEWED_GLOSSARY_PATH = "projects/gb-db-z-gokou/translation/glossary.tsv"
BANNED_PATHS = {
    "tools/bin/gb-text-build",
    "tools/bin/gb-text-catalog",
    "tests/test_text.py",
}
STRUCTURED_CJK_PATHS = {
    "projects/gb-db-z-gokou/analysis/font_tiles.tsv": "character",
    "projects/gb-db-z-gokou/analysis/text_encoding.tsv": "character",
}
BANNED_SUFFIXES = (
    ".gb",
    ".gbc",
    ".rom",
    ".gbs",
    ".vgm",
    ".wav",
    ".sav",
    ".s1",
    ".o",
    ".map",
    ".sym",
    ".bin",
    ".png",
)
CJK = re.compile(r"[\u3040-\u30ff\u3400-\u9fff]")
LONG_HEX_ARRAY = re.compile(r"(?:0x[0-9a-fA-F]{2}\s*,\s*){16,}")
LONG_BYTE_ESCAPE = re.compile(r"(?:\\x[0-9a-fA-F]{2}){16,}")
GLOSSARY_ADDRESS = re.compile(r"03:[0-9A-F]{4}")
GLOSSARY_COLUMNS = [
    "term_id",
    "english",
    "romanization",
    "category",
    "evidence_addresses",
    "reference_count",
    "confidence",
    "notes",
]
GLOSSARY_CATEGORIES = {"character", "species", "place", "event", "item", "technique", "concept"}
GLOSSARY_CONFIDENCE = {"confirmed", "strong", "tentative"}


def source_files() -> list[str]:
    result = subprocess.run(
        ["git", "ls-files", "-z", "--cached", "--others", "--exclude-standard"],
        cwd=ROOT,
        check=True,
        capture_output=True,
    )
    return sorted(
        value.decode()
        for value in result.stdout.split(b"\x00")
        if value and (ROOT / value.decode()).is_file()
    )


def prohibited_path(relative: str) -> str | None:
    path = Path(relative)
    if relative in BANNED_PATHS or any(relative.startswith(prefix) for prefix in BANNED_PREFIXES):
        return f"prohibited path: {relative}"
    if path.parts and path.parts[0] == "roms" and path.name != "README.md":
        return f"prohibited ROM input path: {relative}"
    if "projects" in path.parts and BANNED_PROJECT_COMPONENTS.intersection(path.parts):
        return f"prohibited project-local evidence: {relative}"
    if len(path.parts) >= 4 and path.parts[0] == "projects" and path.parts[2] == "analysis":
        if path.parts[3] == "tiles":
            return f"prohibited extracted project artwork: {relative}"
        if path.name == "bank3_text_tables.tsv":
            return f"prohibited decoded-original catalog: {relative}"
    if (
        "projects" in path.parts
        and path.name in BANNED_BASENAMES
        and relative != REVIEWED_GLOSSARY_PATH
    ):
        return f"prohibited original-language catalog: {relative}"
    if relative.lower().endswith(BANNED_SUFFIXES):
        return f"prohibited file type: {relative}"
    return None


def valid_structured_cjk(relative: str, text: str) -> bool:
    """Allow one reviewed CJK character per TSV row in a designated column."""
    character_column = STRUCTURED_CJK_PATHS.get(relative)
    if character_column is None:
        return False
    try:
        rows = csv.DictReader(io.StringIO(text), delimiter="\t")
        if rows.fieldnames is None or character_column not in rows.fieldnames:
            return False
        for row in rows:
            matches = {
                column: CJK.findall(value or "")
                for column, value in row.items()
                if CJK.search(value or "")
            }
            if matches and (
                set(matches) != {character_column}
                or len(matches[character_column]) != 1
            ):
                return False
    except (csv.Error, TypeError):
        return False
    return True


def validate_reviewed_glossary(text: str) -> list[str]:
    """Validate the one reviewed, dialogue-free terminology manifest."""
    failures = []
    try:
        reader = csv.DictReader(io.StringIO(text), delimiter="\t")
        if reader.fieldnames != GLOSSARY_COLUMNS:
            return ["reviewed glossary has an invalid header"]
        rows = list(reader)
    except (csv.Error, TypeError):
        return ["reviewed glossary is not valid TSV"]

    identifiers = set()
    english_terms = set()
    for line_number, row in enumerate(rows, start=2):
        identifier = row["term_id"]
        english = row["english"]
        if not re.fullmatch(r"[a-z0-9]+(?:_[a-z0-9]+)*", identifier):
            failures.append(f"reviewed glossary line {line_number} has an invalid term ID")
        if identifier in identifiers:
            failures.append(f"reviewed glossary line {line_number} repeats term ID {identifier}")
        identifiers.add(identifier)
        folded_english = english.casefold()
        if not english or folded_english in english_terms:
            failures.append(f"reviewed glossary line {line_number} has a missing or repeated English term")
        english_terms.add(folded_english)
        if row["category"] not in GLOSSARY_CATEGORIES:
            failures.append(f"reviewed glossary line {line_number} has an invalid category")
        if row["confidence"] not in GLOSSARY_CONFIDENCE:
            failures.append(f"reviewed glossary line {line_number} has invalid confidence")
        addresses = row["evidence_addresses"].split(";")
        if not addresses or any(not GLOSSARY_ADDRESS.fullmatch(value) for value in addresses):
            failures.append(f"reviewed glossary line {line_number} has invalid evidence addresses")
        try:
            reference_count = int(row["reference_count"])
        except ValueError:
            reference_count = 0
        if reference_count < len(addresses):
            failures.append(f"reviewed glossary line {line_number} has an invalid reference count")
        if any(token in text for token in ("\\n", "<WAIT>", "<END>")):
            failures.append("reviewed glossary contains dialogue/control syntax")
            break
    if not rows:
        failures.append("reviewed glossary is empty")
    return failures


def main() -> int:
    failures = []
    files = source_files()
    for relative in files:
        failure = prohibited_path(relative)
        if failure:
            failures.append(failure)
            continue
        path = ROOT / relative
        try:
            text = path.read_text(encoding="utf-8")
        except (UnicodeDecodeError, OSError):
            failures.append(f"unreviewed binary file: {relative}")
            continue
        if relative == REVIEWED_GLOSSARY_PATH:
            failures.extend(validate_reviewed_glossary(text))
        if CJK.search(text) and not valid_structured_cjk(relative, text):
            failures.append(f"Japanese/CJK content requires explicit review: {relative}")
        if LONG_HEX_ARRAY.search(text) or LONG_BYTE_ESCAPE.search(text):
            failures.append(f"suspicious embedded byte array requires review: {relative}")

    if failures:
        print("Repository policy audit failed:", file=sys.stderr)
        for failure in failures:
            print(f"  - {failure}", file=sys.stderr)
        return 1
    print(f"Repository policy audit passed for {len(files)} source files.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())