#!/usr/bin/env python3
"""Deprecated single-project wrapper for gb-workstation build."""

import argparse
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT / "toolkit"))

from gbworkbench.cli import main as workstation_main  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("rom", type=Path)
    parser.add_argument("-o", "--output", type=Path, required=True)
    args = parser.parse_args()
    print("warning: gb-translate-build is deprecated; use gb-workstation build", file=sys.stderr)
    return workstation_main(
        [
            "build",
            "gb-db-z-gokou",
            "--rom",
            str(args.rom),
            "--output",
            str(args.output),
        ]
    )


if __name__ == "__main__":
    raise SystemExit(main())